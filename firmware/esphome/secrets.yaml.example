# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
wifi_ssid: "MyWiFi"
wifi_password: "my-wifi-password"
# Used for both the HA API and OTA. 32 random bytes, base64: `openssl rand -base64 32`
# (or copy one from the ESPHome dashboard). The all-zeros placeholder is rejected by the validator.
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
# Fallback hotspot (captive portal) password, min 8 chars
ap_password: "change-me-too"
